{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ashby API Key Interview API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Interview",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "interview.info",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ashbyhq.com/interview.info",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Fetch interview details by id\n\n**Requires the [`interviewsRead`](authentication#permissions-interviewinfo) permission.**\n"
        },
        {
          "info": {
            "name": "interview.list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ashbyhq.com/interview.list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List all interviews.\n\nSee the [Pagination and Incremental Synchronization](/docs/pagination-and-incremental-sync) guide for detailed usage examples.\n\n**Requires the [`interviewsRead`](authentication#permissions-interviewlist) permission.**\n"
        }
      ]
    }
  ],
  "bundled": true
}