{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ashby API Key Close Reason API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Close Reason",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "closeReason.list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ashbyhq.com/closeReason.list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Lists all close reasons for jobs or openings.\n\n**Requires the [`hiringProcessMetadataRead`](authentication#permissions-closereasonlist) permission.**\n"
        }
      ]
    }
  ],
  "bundled": true
}