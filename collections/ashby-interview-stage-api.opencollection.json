{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ashby API Key Interview Stage API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Interview Stage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "interviewStage.list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ashbyhq.com/interviewStage.list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List all interview stages for an interview plan in order.\n\n**Requires the [`interviewsRead`](authentication#permissions-interviewstagelist) permission.**\n"
        },
        {
          "info": {
            "name": "interviewStage.info",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ashbyhq.com/interviewStage.info",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Fetch interview stage details by id\n\n**Requires the [`interviewsRead`](authentication#permissions-interviewstageinfo) permission.**\n"
        }
      ]
    }
  ],
  "bundled": true
}