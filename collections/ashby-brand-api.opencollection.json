{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ashby API Key Brand API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Brand",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "brand.list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ashbyhq.com/brand.list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Lists all brands for the organization.\n\n**Requires the [`organizationRead`](authentication#permissions-departmentinfo) permission.**\n"
        }
      ]
    }
  ],
  "bundled": true
}